{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["@prevalentware/opencode-goal-plugin"],
  "theme": {
    "name": "carbonfox",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "permissions": "autoaccept"
  },
  "tabs": {
    "mode": "off",
    "indicators": "status"
  },
  "attention": {
    "notifications": true
  },
  "debug": {
    "devtools": true
  },
  "experimental": {
    "new-designs": false
  }
}
