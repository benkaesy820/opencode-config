{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["@prevalentware/opencode-goal-plugin"],
  "theme": {
    "name": "carbonfox",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "permissions": "autoaccept",
    "verbosity": "low",
    "tps": false
  },
  "tabs": {
    "mode": "auto",
    "indicators": "status",
    "layout": "horizontal"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.7999999999999999
  },
  "debug": {
    "devtools": true
  },
  "prompt": {
    "paste": "compact",
    "image_preview": false
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "experimental": {
    "new-designs": true,
    "client-mcp": true
  }
}
