{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "dee-mabro",
  "mcp": {
    "servers": {
      "opencode_console": {
        "type": "remote",
        "url": "https://opencode.ai/console/mcp",
        "disabled": true
      },
      "browser-bridge": {
        "type": "local",
        "command": [
          "/usr/bin/node",
          "/home/benkaesy/BrowserX-AgenticBrowser/packages/cli/dist/cli.js",
          "mcp",
          "--stdio"
        ],
        "environment": {
          "BRIDGE_LOG_LEVEL": "warn",
          "BRIDGE_BROWSER": "bundled"
        }
      },
      "research-bridge-v2": {
        "type": "local",
        "command": [
          "/home/benkaesy/.local/bin/research-bridge"
        ],
        "environment": {
          "RESEARCH_HOME": "/home/benkaesy/.local/share/research-bridge"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf /home*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf ~*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --delete*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean -*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cargo publish*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm publish*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "pnpm publish*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wrangler *deploy*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh release create*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh release delete*",
      "effect": "deny"
    }
  ],
  "plugins": [
    "opencode-cmd-provider",
    "@prevalentware/opencode-goal-plugin",
    "@kerneloops/opencode-session-tools"
  ]
}
