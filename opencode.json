{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "dee-mabro",
  "mcp": {
    "servers": {
      "opencode_console": {
        "type": "remote",
        "url": "https://opencode.ai/console/mcp",
        "disabled": true
      },
      "browser-bridge": {
        "type": "local",
        "command": [
          "/usr/bin/node",
          "/home/benkaesy/BrowserX-AgenticBrowser/packages/cli/dist/cli.js",
          "mcp",
          "--stdio"
        ],
        "environment": {
          "BRIDGE_LOG_LEVEL": "warn",
          "BRIDGE_BROWSER": "bundled"
        }
      },
      "research-bridge-v2": {
        "type": "local",
        "command": [
          "/home/benkaesy/.local/bin/research-bridge"
        ],
        "environment": {
          "RESEARCH_HOME": "/home/benkaesy/.local/share/research-bridge"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "paru -S*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "paru -R*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pacman -R*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pacman -U*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -r*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm --recursive*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "find *-delete*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "truncate *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "dd *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "mkfs*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "wipefs *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "fdisk *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "parted *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "chmod -R *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "chown -R *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "systemctl *stop*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "systemctl *disable*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "systemctl *mask*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "reboot*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "shutdown*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "poweroff*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pkill *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "killall *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git rebase *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git cherry-pick *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git revert *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git filter-branch *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git filter-repo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git stash *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -D *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git tag -d *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit --amend *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git restore *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout -- *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout .*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "wrangler deploy*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "wrangler pages deploy*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "wrangler d1 execute*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "wrangler r2 object delete*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh release *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh repo delete*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "cargo publish*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "npm publish*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pnpm publish*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "yarn publish*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "docker push*",
      "effect": "ask"
    }
  ],
  "plugins": [
    "opencode-cmd-provider",
    "@prevalentware/opencode-goal-plugin",
    "@kerneloops/opencode-session-tools"
  ]
}
