{
    "$schema":  "https://opencode.ai/config.json",
    "default_agent":  "advisor",
    "mcp":  {
                "servers":  {
                                "browser-bridge":  {
                                                       "type":  "local",
                                                       "command":  [
                                                                       "node",
                                                                       "C:\\BrowserX-AgenticBrowser\\packages\\cli\\dist\\cli.js",
                                                                       "mcp",
                                                                       "--stdio"
                                                                   ],
                                                       "environment":  {
                                                                           "BRIDGE_BROWSER":  "msedge",
                                                                           "BRIDGE_LOG_LEVEL":  "warn"
                                                                       }
                                                   }
                            }
            },
    "permissions":  [
                        {
                            "action":  "shell",
                            "resource":  "git push *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git reset --hard *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git clean *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git rebase *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git cherry-pick *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git revert *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git filter-branch *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git filter-repo *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git stash *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git branch -D *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git tag -d *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git commit --amend *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git restore *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git checkout -- *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "rm -rf *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "Remove-Item -Recurse *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "npm publish *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "yarn publish *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "pnpm publish *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "docker push *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "terraform apply *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "terraform destroy *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "kubectl apply *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "kubectl delete *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "aws *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "gcloud *",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "az *",
                            "effect":  "ask"
                        }
                    ],
    "plugins":  [
                    "opencode-cmd-provider",
                    "@prevalentware/opencode-goal-plugin"
                ]
}
